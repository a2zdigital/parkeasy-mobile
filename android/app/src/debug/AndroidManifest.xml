<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds only. Plain HTTP is allowed so the app can reach an API
         running on the developer's machine (http://10.0.2.2:8000). Release
         builds use the main manifest alone, where Android's default applies
         and plain HTTP is blocked. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
