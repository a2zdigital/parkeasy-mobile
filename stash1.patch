+      expect(state().failure?.code, ApiErrorCode.serviceUnavailable);
+      expect(state().didSave, isFalse);
+
+      final session = container.read(sessionControllerProvider) as SignedIn;
+      expect(session.user.name, 'Asha');
+    });
+  });
+}
